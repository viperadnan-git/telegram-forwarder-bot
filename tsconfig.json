{
    "compilerOptions": {
        "target": "es2022",
        // Bun bundles; tsc only type-checks. "preserve"/"bundler" is what lets
        // it resolve bun:* modules and modern package exports.
        "module": "preserve",
        "moduleResolution": "bundler",
        // Explicit: TS 7 no longer picks up bun:* declarations otherwise.
        "types": ["bun", "node"],
        "resolveJsonModule": true,
        "esModuleInterop": true,
        "forceConsistentCasingInFileNames": true,
        "strict": true,
        "skipLibCheck": true
    },
    /* The Mini App has its own tsconfig and is checked by svelte-check. */
    "exclude": ["node_modules", "dist", "web"]
}
