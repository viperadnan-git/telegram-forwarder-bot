{
    "compilerOptions": {
        "target": "es2016",
        "module": "commonjs",
        "resolveJsonModule": true,
        "esModuleInterop": true,
        "forceConsistentCasingInFileNames": true,
        "strict": true,
        "skipLibCheck": true
    },
    /* The Mini App has its own tsconfig and is checked by svelte-check. */
    "exclude": ["node_modules", "dist", "web"]
}
