BOT_TOKEN = "1234567890:ABCDEFGHIJKLMNOPQRSTUVWXYZ"
WEBHOOK_HOST = "https://yourdomain.com"
DATABASE_URL = "postgres://user:password@host:5432/forwarder"

# Optional. Only needed for multi-instance or serverless deployments,
# where the in-process cache cannot be shared or does not survive.
# REDIS_URI = "rediss://default:password@host.redis.com:6767"

# Optional cache tuning. Entries are invalidated on every write, so the TTL
# only bounds staleness from changes made outside the app (direct SQL), or
# across instances when REDIS_URI is unset.
# CACHE_TTL_SECONDS = 3600
# CACHE_MAX_ENTRIES = 10000

# Optional. Set when DATABASE_URL points at a transaction pooler:
# migrations need a direct connection.
# DIRECT_DATABASE_URL = "postgres://user:password@host:5432/forwarder"
# DATABASE_POOL_MAX = 10
