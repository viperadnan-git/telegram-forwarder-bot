{
    "name": "telegram-forwarder-bot",
    "description": "Forward Telegram messages between chats using pure Telegram Bot API",
    "main": "src/index.ts",
    "scripts": {
        "dev": "bunx nodemon src/index.ts --delay 3000",
        "build": "bun run build:web && bun build src/index.ts --outfile dist/index.js --target node",
        "build:web": "cd web && bun install && bun run build",
        "dev:web": "cd web && bun run dev",
        "start": "bun run dist/index.js",
        "test": "bun test",
        "format": "biome format --write .",
        "lint": "biome lint .",
        "check": "biome check .",
        "fix": "biome check --write .",
        "typecheck": "tsc --noEmit && cd web && bun run check",
        "verify": "bun run check && bun run typecheck && bun test",
        "db:generate": "drizzle-kit generate",
        "db:migrate": "drizzle-kit migrate",
        "db:studio": "drizzle-kit studio",
        "migrate:redis": "bun run scripts/migrate-redis.ts"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/viperadnan-git/telegram-forwarder-bot.git"
    },
    "keywords": [
        "telegram",
        "message",
        "forward",
        "telegram-forwarder",
        "telegram-message-forwarder"
    ],
    "author": "Adnan Ahmad",
    "license": "GPL-3.0-or-later",
    "bugs": {
        "url": "https://github.com/viperadnan-git/telegram-forwarder-bot/issues"
    },
    "homepage": "https://github.com/viperadnan-git/telegram-forwarder-bot#readme",
    "dependencies": {
        "@grammyjs/auto-retry": "^2.0.2",
        "@grammyjs/parse-mode": "^1.11.1",
        "dotenv": "^16.6.1",
        "drizzle-orm": "^0.45.2",
        "express": "^4.22.1",
        "grammy": "^1.39.3",
        "ioredis": "^5.9.2",
        "postgres": "^3.4.9",
        "re2-wasm": "^1.0.2",
        "uuid": "^14.0.1",
        "winston": "^3.19.0",
        "zod": "^4.4.3"
    },
    "devDependencies": {
        "@biomejs/biome": "^2.5.5",
        "@types/bun": "^1.3.14",
        "@types/express": "^4.17.25",
        "@types/node": "^20.19.33",
        "drizzle-kit": "^0.31.10",
        "nodemon": "^3.1.11",
        "ts-node": "^10.9.2",
        "typescript": "^5.9.3"
    }
}
