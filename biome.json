{
    "$schema": "https://biomejs.dev/schemas/2.5.5/schema.json",
    "vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true },
    "files": {
        "includes": [
            "**",
            "!**/dist",
            "!**/node_modules",
            "!src/db/migrations",
            "!bun.lockb",
            "!bun.lock"
        ]
    },
    "formatter": {
        "enabled": true,
        "indentStyle": "space",
        "indentWidth": 4,
        "lineEnding": "lf",
        "lineWidth": 80
    },
    "linter": {
        "enabled": true,
        "rules": {
            "recommended": true,
            "suspicious": {
                "noExplicitAny": "off"
            },
            "style": {
                "noNonNullAssertion": "off"
            }
        }
    },
    "javascript": {
        "formatter": {
            "quoteStyle": "double",
            "semicolons": "always",
            "trailingCommas": "none",
            "arrowParentheses": "always"
        }
    },
    "assist": {
        "enabled": true,
        "actions": { "source": { "organizeImports": "on" } }
    },
    "overrides": [
        {
            "includes": ["**/*.svelte", "**/*.svg"],
            "linter": {
                "rules": {
                    "correctness": {
                        "noUnusedVariables": "off",
                        "noUnusedImports": "off"
                    },
                    "style": { "useConst": "off", "useImportType": "off" },
                    "a11y": { "noSvgWithoutTitle": "off" }
                }
            }
        }
    ]
}
